# Production environment template for Docker Compose
# Copy to `.env` on the target VPS and fill in real secrets.

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=wep_education

# Backend
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=wep-media
MINIO_PUBLIC_URL=https://your-domain/media
MINIO_SECURE=true

# CORS - update to your real domain (comma-separated URLs)
BACKEND_CORS_ORIGINS=https://your-domain
