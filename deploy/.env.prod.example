# Production environment template for Docker Compose
# Copy to `.env` on the target VPS and fill in real secrets.

# PostgreSQL
POSTGRES_USER=wep_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wep_education

# Backend
SECRET_KEY=CHANGE_ME_LONG_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=wep-media
MINIO_PUBLIC_URL=https://your-domain:9000
MINIO_SECURE=true

# CORS — update to your real domain
BACKEND_CORS_ORIGINS=["https://your-domain"]
