# Development environment template for Docker Compose (infra only)
# Copy to `.env` and fill in values.

# PostgreSQL
POSTGRES_USER=wep_user
POSTGRES_PASSWORD=wep_password
POSTGRES_DB=wep_education

# Postgres port exposed to host (default 5433 to avoid conflicts)
POSTGRES_PORT=5433

# Application server
SECRET_KEY=development-secret-key

# MinIO (S3-compatible object storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wep-media
