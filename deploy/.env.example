# Copy to `.env` and fill in all values before running docker-compose.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=wep
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wep_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-random-64-char-string

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=wep-media
# Public URL used to generate presigned links for media files.
# In production: https://<your-domain>/media
# In local dev:  http://localhost:9000
MINIO_PUBLIC_URL=https://your-domain.example/media

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
BACKEND_CORS_ORIGINS=["https://your-domain.example"]
