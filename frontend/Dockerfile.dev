# Development Dockerfile for the Test Constructor frontend
# Uses Bun for package management and Vite for dev server.
FROM oven/bun:1-alpine

WORKDIR /app

# Install dependencies first (cached layer)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy source code (volume will override in compose for live reload)
COPY . .

EXPOSE 5173

# Use --host 0.0.0.0 so Vite is reachable from outside the container
CMD ["bun", "run", "dev", "--", "--host"]
